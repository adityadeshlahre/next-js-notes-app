{
  "name": "next-js-notes-app",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "typescript": "^6.0.3",
      "lucide-react": "^1.27.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "sonner": "^2.0.7",
      "better-auth": "1.6.25",
      "@tailwindcss/postcss": "^4.3.3",
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3",
      "tailwindcss": "^4.3.3"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "test": "vitest run",
    "lint": "oxlint",
    "dev:web": "turbo run dev -F web",
    "db:push": "turbo run db:push -F @next-js-notes-app/db",
    "db:studio": "turbo run db:studio -F @next-js-notes-app/db",
    "db:generate": "turbo run db:generate -F @next-js-notes-app/db",
    "db:migrate": "turbo run db:migrate -F @next-js-notes-app/db",
    "db:start": "docker compose up -d postgres",
    "db:watch": "docker compose up postgres",
    "db:stop": "docker compose stop postgres",
    "db:down": "docker compose down postgres",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "check": "oxlint && oxfmt --write",
    "prepare": "husky"
  },
  "dependencies": {
    "@next-js-notes-app/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@next-js-notes-app/auth": "workspace:*",
    "@next-js-notes-app/config": "workspace:*",
    "@next-js-notes-app/db": "workspace:*",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.20.0",
    "drizzle-orm": "^0.45.2",
    "husky": "^9.1.7",
    "lefthook": "^2.1.10",
    "lint-staged": "^17.2.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "pg": "^8.16.0",
    "turbo": "^2.10.7",
    "typescript": "catalog:",
    "vitest": "^4.1.0"
  },
  "lint-staged": {
    "*": [
      "oxfmt --write"
    ],
    "*.{js,ts,jsx,tsx}": [
      "oxlint"
    ]
  },
  "packageManager": "bun@1.3.14"
}
